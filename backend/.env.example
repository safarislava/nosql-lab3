RIAK__BASE_URL=http://riak:8098
RIAK__TIMEOUT=5.0

POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=nosql_store
POSTGRES__MIN_CONNECTIONS=1
POSTGRES__MAX_CONNECTIONS=10

AUTH__JWT_SECRET_KEY=your-secret-key
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=60
AUTH__COOKIE_SECURE=false
AUTH__COOKIE_HTTPONLY=true
AUTH__COOKIE_SAMESITE=lax

COUCHDB__NODE0_URL=http://couchdb1:5984
COUCHDB__NODE1_URL=http://couchdb2:5984
COUCHDB__USER=admin
COUCHDB__PASSWORD=password
COUCHDB__PRODUCTS_DB=products
COUCHDB__CATEGORIES_DB=categories
COUCHDB__TIMEOUT=5.0

CASSANDRA__HOSTS=cassandra1,cassandra2,cassandra3
CASSANDRA__PORT=9042
CASSANDRA__KEYSPACE=store
CASSANDRA__CONSISTENCY_LEVEL=QUORUM
CASSANDRA__BUCKET_SECONDS_TYPE=86400
CASSANDRA__BUCKET_SECONDS_ENTITY=604800
CASSANDRA__BUCKET_SECONDS_USER=2592000

APP_VERSION=2